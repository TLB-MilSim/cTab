@model HomeVM
@inject IViewLocalizer Localizer
@inject CommunautyInfos Communauty
@{
    Layout = "_Layout";
    ViewData["Title"] = SharedResource.Home;
}

<section class="ctab-hero">
    <p class="eyebrow">@(string.IsNullOrEmpty(Communauty.Name) ? "cTab IRL" : Communauty.Name + " · cTab IRL")</p>
    <h1>@Localizer["cTab outside the game"]</h1>
    <p class="ctab-lead">@Localizer["See your in-game cTab live on a phone, tablet or second monitor, outside of Arma 3."]</p>
    @if (!string.IsNullOrEmpty(Communauty.Name))
    {
        <p class="ctab-hosted">
            <a href="@Communauty.Home">@Localizer["Hosted by {0}", Communauty.Name]</a>
        </p>
    }
</section>

@if (Model.Error != null)
{
    <p class="alert alert-danger" role="alert">@Model.Error</p>
}

@if (Model.CurrentState != null)
{
    <div class="ctab-card ctab-card--accent ctab-resume" role="status">
        <div>
            <h2>@Localizer["Active cTab session"]</h2>
            <p>@Localizer["A cTab session is still available, you may want to connect back."]</p>
        </div>
        <a class="btn btn-success" asp-action="Map" asp-route-t="@Model.CurrentState.Token">@Localizer["Connect to cTab"]</a>
    </div>
}

<section class="ctab-card ctab-step">
    <span class="ctab-step-num" aria-hidden="true">01</span>
    <div>
        <h2>@Localizer["Install SIT 1erGTD mod"]</h2>
        <p>@Localizer["Download the mod from the <a href=\"{0}\">Steam Workshop</a>, or from <a href=\"{1}\">GitHub</a>.", "https://steamcommunity.com/workshop/filedetails/?id=2262009445", "https://github.com/jetelain/cTab"]</p>
    </div>
</section>

<div class="ctab-options">
    <section class="ctab-card">
        <p class="eyebrow"><span class="ctab-step-num ctab-step-num--sm" aria-hidden="true">02</span> Steam</p>
        <h2>@Localizer["Connect with Steam and cTab Key"]</h2>
        @if (Model.Providers.Length > 0)
        {
            <ol>
                <li>@Localizer["Open {0} in a browser on your phone, tablet or second monitor.", Model.PublicUri]</li>
                <li>@Localizer["Signin with steam."]</li>
                <li>@Localizer["In-game, once the message 'cTab connected to {0}.' appears, open map with key <kbd>m</kbd> (qwerty keyboard).", Model.PublicUri]</li>
                <li>@Localizer["Go into 'cTab IRL', 'Connect a mobile device', locate the key displayed (6 digits)."]</li>
                <li>@Localizer["Type here the key and validate."]</li>
            </ol>

            <div class="ctab-card-action">
                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    <form method="post" asp-action="EnterKey">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <div class="input-group-text"><i class="fas fa-key"></i></div>
                            </div>
                            <input type="text" class="form-control" id="key" name="key" placeholder="@Localizer["Key"]" inputmode="numeric" autocomplete="off" />
                            <div class="input-group-append">
                                <button class="btn btn-success" type="submit">@Localizer["Validate"]</button>
                            </div>
                        </div>
                    </form>
                }
                else
                {
                    @foreach (var scheme in Model.Providers.OrderBy(p => p.DisplayName))
                    {
                        <form method="post" asp-action="SignIn">
                            <input type="hidden" name="Provider" value="@scheme.Name" />
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" value="true" id="isPersistent" name="isPersistent">
                                <label class="form-check-label" for="isPersistent">
                                    @Localizer["Rember me"]
                                </label>
                            </div>
                            <button class="btn btn-success btn-block" type="submit"><i class="fab fa-steam"></i> @Localizer["Connect with {0}", scheme.DisplayName]</button>
                        </form>
                    }
                }
            </div>
        }
        else
        {
            <p class="text-muted">@Localizer["Unavailable"]</p>
        }
    </section>

    <section class="ctab-card">
        <p class="eyebrow"><span class="ctab-step-num ctab-step-num--sm" aria-hidden="true">02</span> QR code</p>
        <h2>@Localizer["Connect with QR Code (easier)"]</h2>
        <ol>
            <li>@Localizer["In-game, once the message 'cTab connected to {0}.' appears, open map with key <kbd>m</kbd> (qwerty keyboard).", Model.PublicUri]</li>
            <li>@Localizer["Go into 'cTab IRL', 'Connect a mobile device', then scan the code with your phone or tablet camera."]</li>
        </ol>
        <img class="ctab-qr-shot" src="~/img/qrcode.png" alt="" />
    </section>
</div>

