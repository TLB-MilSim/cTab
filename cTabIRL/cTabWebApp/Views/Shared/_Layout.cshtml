@inject CommunautyInfos Communauty
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#100F0D" />
    @if (ViewData["Description"] != null)
    {
        <meta name="description" content="@ViewData["Description"]" />
    }
    @{
        // Tab titles across the TLB suite: "TLB MilSim · <App> · <Page>" (no page part on the app's main page).
        var pageTitle = ViewData["Title"] as string;
        var titleSuffix = string.IsNullOrEmpty(pageTitle) || pageTitle == SharedResource.Home ? "" : " · " + pageTitle;
        var unitName = string.IsNullOrEmpty(Communauty.Name) ? "TLB MilSim" : Communauty.Name;
    }
    <title>@unitName · cTab@(titleSuffix)</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" integrity="sha384-JcKb8q3iqJ61gNV9KGb8thSsNjpSL0n8PARn9HuZOnIxN0hoP+VmmDGMN5t9UJ0Z" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.5.0/css/all.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />
    <link rel="icon" type="image/png" href="~/tlb/tlb-favicon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/tlb/tlb-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/tlb/tlb-suite-bar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <script src="~/tlb/tlb-suite-bar.js" asp-append-version="true" data-app="ctab"></script>

    <header class="ctab-header">
        <div class="container ctab-header-inner">
            <a class="ctab-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="ctab-brand-icon" aria-hidden="true"><i class="fas fa-tablet-alt"></i></span>
                <span>cTab <small>IRL</small></span>
            </a>
            <nav class="ctab-subnav" aria-label="cTab">
                <a asp-controller="Home" asp-action="Index"><i class="fas fa-sign-in-alt"></i> @SharedResource.Home</a>
                <a asp-controller="Session" asp-action="Replay"><i class="fas fa-play-circle"></i> @SharedResource.Replay</a>
                <a href="https://steamcommunity.com/workshop/filedetails/?id=2262009445" target="_blank" rel="noopener"><i class="fas fa-download"></i> @SharedResource.Download</a>
            </nav>
            @* With the shared TLB sign-in, the top bar shows the account and Sign out. *@
            @if ((User?.Identity?.IsAuthenticated ?? false) && Context.RequestServices.GetService(typeof(cTabWebApp.TlbAuthSettings)) == null)
            {
                <div class="ctab-user">
                    <span class="ctab-user-name"><i class="fab fa-steam"></i> @User.Identity.Name</span>
                    <a asp-controller="Home" asp-action="SignOut" class="btn btn-sm btn-secondary" title="@User.Identity.Name">
                        @SharedResource.Disconnect
                    </a>
                </div>
            }
        </div>
    </header>

    <div class="title">
        <div class="container">
            @RenderSection("Title", required: false)
        </div>
    </div>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderSection("NavBar", required: false)
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            <span>
                @if (!string.IsNullOrEmpty(Communauty.Name))
                {
                    <text>@Communauty.Name ·</text>
                }
                cTab IRL by <a href="https://github.com/jetelain/cTab" target="_blank" rel="noopener">jetelain</a>
            </span>
            <span>
                <a asp-controller="Home" asp-action="Privacy">@SharedResource.Privacy</a>
                @if (!string.IsNullOrEmpty(Communauty.Contact))
                {
                    @:· <a href="@Communauty.Contact">@SharedResource.Contact</a>
                }
            </span>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js" integrity="sha384-9/reFTGAW83EW2RDu2S0VKaIzap3H66lZH81PoYlFhbGU+6BZp6G7niu735Sk7lN" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js" integrity="sha384-B4gt1jrGC7Jh4AgTPSdUtOBvfO8shuf57BaghqFfPlYxofvL8/KUEfYiJOMMV+rV" crossorigin="anonymous"></script>
    @*<script src="~/js/site.js" asp-append-version="true"></script>*@
    @RenderSection("Scripts", required: false)
</body>
</html>
