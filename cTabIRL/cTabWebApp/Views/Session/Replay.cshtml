@model cTabWebApp.Models.ReplayVM
@inject IViewLocalizer Localizer
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, height=device-height, initial-scale=1.0, user-scalable=no" />
    <title>TLB MilSim · cTab · Replay</title>
    <link rel="icon" type="image/png" href="~/tlb/tlb-favicon.png" asp-append-version="true" />
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" integrity="sha384-JcKb8q3iqJ61gNV9KGb8thSsNjpSL0n8PARn9HuZOnIxN0hoP+VmmDGMN5t9UJ0Z" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.6.0/dist/leaflet.css" integrity="sha512-xwE/Az9zrjBIphAcBb3F6JVqxf46+CDLwfLMHloNu6KEQCAWi6HcDUbeOfBIptF7tcCzusKFjFw2yuvEpDL9wQ==" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.5.0/css/all.css" />
    <link rel="stylesheet" href="~/css/map.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/replay.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/tlb/tlb-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/tlb/tlb-suite-bar.css" asp-append-version="true" />
    <style>
        /* TLB suite: leave room for the shared top bar and theme the replay chrome. */
        .map { height: calc(100vh - var(--tlb-bar-h)); }
        .modal-content { color: var(--text-body); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-xl); box-shadow: var(--shadow-overlay); }
        .modal-header, .modal-footer, .modal-body hr { border-color: var(--line); }
        .modal-title, .modal-body h6 { color: var(--text); font-family: var(--font-display); font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
        .modal-title i { color: var(--amber); }
        .modal-body .text-muted { color: var(--muted) !important; }
        .modal-body code { color: var(--amber); }
        .modal-body .table { color: var(--text-body); }
        .modal-body .table td, .modal-body .table th { border-top-color: var(--line); }
        #replay-controls { background: var(--overlay-bg); border-top-color: var(--line); color: var(--text-body); }
        #replay-recording-name { color: var(--muted); }
        #replay-controls .form-control { color: var(--text); background: var(--surface-sunken); border-color: var(--line); }
        #replay-timeline { accent-color: var(--amber); }
        .btn { font-family: var(--font-display); font-weight: 600; letter-spacing: .06em; text-transform: uppercase; border-radius: var(--radius-md); }
        .btn-primary, .btn-primary:hover, .btn-primary:focus { color: var(--accent-fg); background: var(--amber); border-color: var(--amber); }
        .btn-primary:hover { background: var(--amber-bright); border-color: var(--amber-bright); }
        .btn-outline-secondary { color: var(--muted); border-color: var(--line-strong); }
        .btn-outline-secondary:hover { color: var(--text); background: var(--surface-hover); border-color: var(--line-strong); }
        a { color: var(--amber); }
    </style>
</head>
<body>
    <script src="~/tlb/tlb-suite-bar.js" asp-append-version="true" data-app="ctab"></script>
    <div class="modal" id="replay-overlay" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-play-circle"></i> cTab Replay</h5>
                </div>
                <div class="modal-body">
                    <p class="text-muted">@Localizer["Load a session recording file (<code>.json</code>) exported from cTab."]</p>
                    <p class="text-muted">@Localizer["To record a session, open cTab, click on the menu button <i class=\"fas fa-bars\"></i> and then on \"<i class=\"fas fa-circle\"></i> Start recording\"."]</p>

                    <div class="form-group">
                        <label for="replay-file">@Localizer["Recording file"]</label>
                        <input type="file" class="form-control-file" id="replay-file" accept=".json" />
                    </div>
                    @if (Model.Recordings.Count > 0)
                    {
                        <hr />
                        <h6>@Localizer["Previous sessions"]</h6>
                        <table class="table">
                            @foreach (var r in Model.Recordings)
                            {
                                var downloadUrl = Url.Action("DownloadStored", "Session", new { id = r.Token });
                                <tr>
                                    <td>@(r.WorldName ?? "?")</td>
                                    <td>@r.RecordingStart.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                    <td>
                                        <a href="@downloadUrl" class="btn btn-sm btn-outline-secondary mr-1" title="@Localizer["Download"]"><i class="fas fa-download"></i></a>
                                         <button class="btn btn-sm btn-outline-secondary" data-replay-src="@downloadUrl" title="@Localizer["Open in viewer"]"><i class="fas fa-play"></i></button>
                                    </td>
                                </tr>
                            }
                        </table>
                        <p><span class="text-muted">@Localizer["Note: Data is only stored for a few days. Download the file to store the data longer."]</span></p>
                    }
                </div>
                <div class="modal-footer">
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Home" asp-action="Index"><i class="fas fa-sign-out-alt"></i> @Localizer["Exit and return to home"]</a>
                </div>
            </div>
        </div>
    </div>

    <div class="map" id="map"></div>

    <div id="replay-controls" class="d-none">
        <button id="replay-play-btn" class="btn btn-sm btn-primary" title="@Localizer["Play / Pause"]">
            <i class="fas fa-play"></i>
        </button>
        <input type="range" id="replay-timeline" min="0" max="1000" value="0" step="1" class="custom-range" />
        <span id="replay-time" class="text-monospace d-none d-md-inline">00:00:00 / 00:00:00</span>
        <span id="replay-clock" class="badge badge-secondary ml-1" title="@Localizer["In-game time"]">--:--</span>
        <select id="replay-speed" class="form-control form-control-sm" style="width:auto;" title="@Localizer["Playback speed"]">
            <option value="0.5">0.5×</option>
            <option value="1" selected>1×</option>
            <option value="2">2×</option>
            <option value="4">4×</option>
            <option value="8">8×</option>
            <option value="16">16×</option>
            <option value="32">32×</option>
        </select>
        <span id="replay-recording-name" class="ml-2"></span>
        <button id="replay-load-btn" class="btn btn-sm btn-outline-secondary ml-auto" title="@Localizer["Load another file"]">
            <i class="fas fa-folder-open"></i>
        </button>
        <a class="btn btn-sm btn-outline-secondary ml-auto" title="@Localizer["Exit and return to home"]" asp-action="Index" asp-controller="Home">
            <i class="fas fa-sign-out-alt"></i>
        </a>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js" integrity="sha384-9/reFTGAW83EW2RDu2S0VKaIzap3H66lZH81PoYlFhbGU+6BZp6G7niu735Sk7lN" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js" integrity="sha384-B4gt1jrGC7Jh4AgTPSdUtOBvfO8shuf57BaghqFfPlYxofvL8/KUEfYiJOMMV+rV" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.6.0/dist/leaflet.js" integrity="sha512-gZwIG9x3wUXg2hdXF6+rVkLF/0Vi9U8D2Ntg4Ga5I5BZpVkVxlJWbSQtXPSiUTtC0TjtGOmxa1AJPuV0CPthew==" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/milsymbol@2.0.0/dist/milsymbol.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/milstd@0.1.6/milstd.js"></script>
    <script src="https://atlas.plan-ops.fr/js/legacy-map-utils.js"></script>
    <script src="https://atlas.plan-ops.fr/data/1/maps/all.js"></script>
    <script src="~/js/leaflet-distortableimage.js" asp-append-version="true"></script>
    <script src="~/js/ctab-replay.js" asp-append-version="true"></script>
</body>
</html>
